                                            "draft",
                                            "published",
                                            "cancelled",
                                            "completed"
                                        ],
                                        "example": "published"
                                    },
                                    "category": {
                                        "type": "string",
                                        "maxLength": 255,
                                        "example": "Education"
                                    },
                                    "metadata": {
                                        "type": "object",
                                        "example": {
                                            "featured": false
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
